generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionSource {
  MANUAL
  AI
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  ADAPTIVE
}

model User {
  id               String        @id @default(uuid())
  fullName         String
  email            String        @unique
  passwordHash     String
  role             Role          @default(STUDENT)
  status           AccountStatus @default(ACTIVE)
  program          String?
  level            String?
  weeklyStudyHours Int           @default(10)
  availability     String        @default("Matin")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  progress      ChapterProgress[]
  resources     Resource[]
  ratings       Rating[]
  favorites     Favorite[]
  reports       Report[]
  groupsOwned   StudyGroup[]      @relation("GroupOwner")
  memberships   GroupMember[]
  messages      GroupMessage[]
  exams         Exam[]
  sessions      StudySession[]
  quizzes       Quiz[]
  notifications Notification[]
  subjects      Subject[]
}

model Program {
  id       String    @id @default(uuid())
  name     String    @unique
  subjects Subject[]
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  ownerId   String?
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  programId String?
  program   Program?   @relation(fields: [programId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  resources Resource[]
  exams     Exam[]

  @@index([ownerId])
}

model Chapter {
  id        String  @id @default(uuid())
  title     String
  order     Int
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  progress  ChapterProgress[]
  resources Resource[]
  quizzes   Quiz[]
  sessions  StudySession[]

  @@unique([subjectId, order])
}

model ChapterProgress {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  mastery   Int      @default(0)
  notes     String?
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Resource {
  id          String           @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  mimeType    String
  status      ModerationStatus @default(APPROVED)
  isPublic    Boolean          @default(false)
  downloads   Int              @default(0)
  authorId    String
  subjectId   String?
  subjectName String
  chapterId   String?
  createdAt   DateTime         @default(now())

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject Subject?  @relation(fields: [subjectId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])

  ratings   Rating[]
  favorites Favorite[]
  reports   Report[]
}

model Rating {
  id         String   @id @default(uuid())
  value      Int
  comment    String?
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model Favorite {
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

model Report {
  id         String   @id @default(uuid())
  reason     String
  resolved   Boolean  @default(false)
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model StudyGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  subject     String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner    User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model GroupMessage {
  id        String   @id @default(uuid())
  content   String
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  room      String?
  userId    String
  subjectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
}

model StudySession {
  id        String        @id @default(uuid())
  title     String
  startsAt  DateTime
  duration  Int
  source    SessionSource @default(MANUAL)
  completed Boolean       @default(false)
  userId    String
  chapterId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id])
}

model Quiz {
  id         String     @id @default(uuid())
  difficulty Difficulty @default(ADAPTIVE)
  questions  Json
  userId     String
  chapterId  String
  createdAt  DateTime   @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter      @relation(fields: [chapterId], references: [id])
  results QuizResult[]
}

model QuizResult {
  id        String   @id @default(uuid())
  score     Int
  total     Int
  answers   Json
  quizId    String
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}